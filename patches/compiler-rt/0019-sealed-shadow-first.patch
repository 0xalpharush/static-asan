 }
 
+#  if SANITIZER_LINUX
+// Set by SealedReserveShadow once the three ranges are mapped, and what makes
+// InitializeShadowMemory below leave them alone.
+static bool sealed_shadow_reserved;
+
+static void SealedReserveRange(uptr beg, uptr end, int prot) {
+  uptr size = end - beg + 1;
+  uptr res = internal_mmap(reinterpret_cast<void *>(beg), size, prot,
+                           MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE |
+                               MAP_FIXED_NOREPLACE,
+                           -1, 0);
+  // Three answers are not the range: an errno (EEXIST is a mapping already
+  // there, ENOMEM a space too small for the layout), a mapping placed
+  // elsewhere by a kernel that predates the flag and read it as a hint, and
+  // -- not possible for MAP_FIXED_NOREPLACE, but the test is the same -- any
+  // other address.  All are the runtime failing to get memory for itself at
+  // start-up, and take the one path that has: see
+  // SealedHangOnAllocationFailure.
+  if (res != beg)
+    SealedHangOnAllocationFailure();
+  DecreaseTotalMmap(size);  // Not counted against mmap_limit_mb, as ever.
+}
+#  endif
+
+// The shadow and its gap, reserved before the runtime's first allocation.
+//
+// The unsealed runtime reserves them from InitializeShadowMemory, after the
+// flag parser and the internal allocator have each taken a mapping at no
+// fixed address, and it maps them with MAP_FIXED after asking /proc/self/maps
+// whether the range is free.  Sealed init reads no /proc, so patch 0012 had
+// that question answer yes unasked, which left the MAP_FIXED calls unchecked:
+// any mapping the kernel had placed in the range -- the two runtime mappings
+// before it, or anything the program started with -- was covered by the
+// shadow without a word, and the specification these binaries are verified
+// against admits every placement the kernel could make, under either mmap
+// layout and any address-space size.  So the sealed runtime reserves first,
+// with MAP_FIXED_NOREPLACE, which the kernel refuses with EEXIST where
+// MAP_FIXED would have replaced.  Nothing the runtime maps afterwards can
+// land inside, since the kernel places an unhinted mapping only in free
+// space, and what a program starts with -- its own segments, the stack, the
+// vDSO, the TLS block musl maps -- is a collision the reservation refuses
+// rather than one it hides.
+//
+// It runs before InitializeFlags, so the three ranges are the ones the
+// defaults name, and protect_shadow_gap is pinned to 1 afterwards
+// (SealFlags).  The syscalls are the same three mmaps InitializeShadowMemory
+// would have made, in ascending order, each with one more flag: a sealed
+// start-up makes no new syscall, the mappings just come first.
+void SealedReserveShadow() {
+#  if SANITIZER_LINUX
+  if (!SealedInit())
+    return;
+#    if SANITIZER_RISCV64
+  // The offset asan_mapping.h reads MEM_TO_SHADOW's constant out of on this
+  // architecture, set here so that the k* bounds below are the layout's.
+  // FindDynamicShadowStart answers the same constant later.
+  __asan_shadow_memory_dynamic_address = kSealedShadowOffset;
+#    endif
+  // kHighMemEnd is set: the caller ran InitializeHighMemEnd first.
+  uptr shadow_start = kLowShadowBeg - GetMmapGranularity();
+  SealedReserveRange(shadow_start, kLowShadowEnd, PROT_READ | PROT_WRITE);
+  SealedReserveRange(kShadowGapBeg, kShadowGapEnd, PROT_NONE);
+  SealedReserveRange(kHighShadowBeg, kHighShadowEnd, PROT_READ | PROT_WRITE);
+  sealed_shadow_reserved = true;
+#  endif
+}
+
 void InitializeShadowMemory() {
   // Set the shadow memory address to uninitialized.
   __asan_shadow_memory_dynamic_address = kDefaultShadowSentinel;
@@ -86,6 +160,17 @@ void InitializeShadowMemory() {
 
   if (Verbosity()) PrintAddressSpaceLayout();
 
+#  if SANITIZER_LINUX
+  // A sealed run reserved these before anything else (SealedReserveShadow),
+  // and what follows would map over its own reservation with MAP_FIXED: three
+  // syscalls that change nothing.  The invariant the fixed-mapping branch
+  // checks is checked here too.
+  if (sealed_shadow_reserved) {
+    CHECK_EQ(kShadowGapEnd, kHighShadowBeg - 1);
+    return;
+  }
+#  endif
+
   if (full_shadow_is_available) {
     // mmap the low shadow plus at least one page at the left.
     if (kLowShadowBeg)
