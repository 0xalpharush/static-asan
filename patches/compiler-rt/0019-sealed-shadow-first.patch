+// The frame the runtime's initialization started on, recorded by __asan_init
+// before it calls anything, and 0 until it does.  Declared here because the
+// riscv64 address-space detection below reads it; what else reads it, and why
+// it has to be that frame, is with kSealedMainStackSize further down.
+extern uptr sealed_init_frame;
+
 #if SANITIZER_RISCV64
 // riscv64 is the one architecture here whose shadow offset is not a constant:
 // asan_mapping.h selects ASAN_SHADOW_OFFSET_DYNAMIC for it, the offset comes
 // out of an mmap probe sized by GetMaxVirtualAddress(), and that function
 // answers `(1 << (msb(current frame) + 1)) - 1` because RISC-V has three
 // address space layouts (Sv39, Sv48, Sv57) and nothing tells a process which
-// one it is running under.  So the size of the shadow reservation is a
-// function of the initial stack pointer.
+// one it is running under.
 //
-// Sealed mode pins both to the Sv48 layout, which is the one Linux/riscv64
-// gives a process on any kernel with VA_BITS >= 48: STACK_TOP is
-// DEFAULT_MAP_WINDOW = 1 << (MMAP_VA_BITS - 1), and MMAP_VA_BITS saturates at
-// 48, so the stack top is 0x800000000000 under Sv48 and Sv57 alike and the top
-// user address is 0x7fffffffffff.  The offset is the one asan_mapping.h already
-// uses for every other 47-bit user address space, x86_64's included:
+// Sealed mode pins the offset and detects the size.  The offset is the one
+// asan_mapping.h uses for every other 47-bit user address space, x86_64's
+// included, and it is valid under Sv39 as well: the shadow of a 256GiB space
+// is a 32GiB band above the offset.  The size is read off the frame
+// __asan_init started on -- sealed_init_frame, recorded before anything else
+// -- the way the unsealed runtime reads it off the current frame.  Linux puts
+// the stack at the top of the window an unhinted mmap allocates from,
+// STACK_TOP = DEFAULT_MAP_WINDOW = 1 << (MMAP_VA_BITS - 1), so the frame's
+// magnitude names the layout: 1 << 38 under Sv39, 1 << 47 under Sv48, and
+// MMAP_VA_BITS saturates at 48, so Sv57 answers as Sv48.  The initial stack
+// pointer is one of the things a caller reasoning about these binaries
+// quantifies over, and the rule this implements is that the layout is a
+// function of it -- deterministic in the model -- which is what makes reading
+// the frame admissible where reading /proc was not.  An earlier version of
+// this pinned Sv48 outright, so that the same binary refused an Sv39 kernel;
+// one runtime that serves both is what was asked for instead.
 //
-//   || `[0x10007fff8000, 0x7fffffffffff]` || HighMem    ||
-//   || `[0x02008fff7000, 0x10007fff7fff]` || HighShadow ||
-//   || `[0x00008fff7000, 0x02008fff6fff]` || ShadowGap  ||
-//   || `[0x00007fff8000, 0x00008fff6fff]` || LowShadow  ||
-//   || `[0x000000000000, 0x00007fff7fff]` || LowMem     ||
+// One runtime, one offset, the same instrumented code, two layouts:
 //
-// Sv39 is the other plausible pin, and it is the wrong one here even though it
-// is what much riscv64 hardware runs and it would make the reservation 4GB
-// rather than 14TB.  A caller reasoning about these binaries quantifies the
-// initial stack pointer over the window a kernel can put it in, and on an Sv48
-// kernel every such stack address is above an Sv39 ceiling -- so an Sv39-sealed
-// binary would take the diagnostic path below on every admissible run, which is
-// worse than not sealing at all.  Changing this pin is these two constants and
-// the mapping table above; nothing else here depends on which it is.
-const uptr kSealedMaxUserVirtualAddress = 0x7fffffffffffULL;
+//   Sv48, top 0x7fffffffffff                Sv39, top 0x3fffffffff
+//   [0x10007fff8000, 0x7fffffffffff] HighMem     [0x087fff8000, 0x3fffffffff]
+//   [0x02008fff7000, 0x10007fff7fff] HighShadow  [0x018fff7000, 0x087fff7fff]
+//   [0x00008fff7000, 0x02008fff6fff] ShadowGap   [0x0008fff7000, 0x018fff6fff]
+//   [0x00007fff8000, 0x00008fff6fff] LowShadow   the same
+//   [0x000000000000, 0x00007fff7fff] LowMem      the same
+//
+// which is a 14TiB reservation under Sv48 and 32GiB under Sv39.  Where it is
+// made, and why before anything else, is SealedReserveShadow in
+// asan_shadow_setup.cpp.
 const uptr kSealedShadowOffset = 0x7fff8000ULL;
+const uptr kSealedSv39TopOfMemory = 0x3fffffffffULL;
+const uptr kSealedSv48TopOfMemory = 0x7fffffffffffULL;
 
-// The pin above is one statement about the address space, and
-// SANITIZER_MMAP_RANGE_SIZE is the same statement made in sanitizer_platform.h,
-// where it sizes the first level of the bytemap the internal allocator uses to
-// find a region's size class.  They were allowed to disagree once -- the pin
-// said Sv48 and the range size said 56 bits -- and the cost of that was not
-// wrongness but 128MiB of .bss where 256KiB was called for.  A header that
-// sanitizer_platform.h could include would be the tidier fix; it includes
-// nothing, by design, so this is what holds the two together: move the pin and
-// this stops the build until the other moves with it.
-//
-// It is an equality and not just the soundness bound (>=), deliberately.  The
-// bound is what makes the allocator correct, and a range size larger than the
-// pin would satisfy it; but a binary that pins Sv48 and then reserves a bytemap
-// for an address space it has just said it will refuse to run in is carrying
-// the cost of a generality the seal has already spent.
+inline uptr SealedTopOfMemory() {
+  // With the frame at 0x7ff... this is Sv48's top; at 0x3ff..., Sv39's.  Any
+  // other magnitude is a kernel this runtime was not written for, and the
+  // reservation is where that is found out: a layout the arithmetic below
+  // holds for is reserved, one it does not hold for collides or is refused,
+  // and either way nothing is mapped over something else.
+  return (1ULL << ((63 - __builtin_clzll(sealed_init_frame)) + 1)) - 1;
+}
+
+// The layout arithmetic, mirrored from asan_mapping.h at shadow scale 3 and
+// held for both layouts at compile time: each region ends before the next
+// begins, HighMem exists, and the gap is exactly the shadow of the shadow.
+// This is the check an Sv39 machine would make at start-up, made here because
+// no Sv39 machine runs this project's suite.
+constexpr uptr SealedMemToShadow(uptr mem) {
+  return (mem >> 3) + kSealedShadowOffset;
+}
+constexpr bool SealedLayoutHolds(uptr top) {
+  return
+      // LowMem, LowShadow, ShadowGap, HighShadow, HighMem, in that order.
+      SealedMemToShadow(kSealedShadowOffset - 1) + 1 <=            // gap begins
+          SealedMemToShadow(SealedMemToShadow(top) + 1) - 1 &&     // gap ends
+      SealedMemToShadow(SealedMemToShadow(top) + 1) <=             // high shadow
+          SealedMemToShadow(top) &&
+      SealedMemToShadow(top) < SealedMemToShadow(top) + 1 &&        // HighMem begins
+      SealedMemToShadow(top) + 1 < top &&                           // and exists
+      // The gap is the shadow of [LowShadowBeg, HighShadowEnd].
+      SealedMemToShadow(kSealedShadowOffset) ==
+          SealedMemToShadow(kSealedShadowOffset - 1) + 1 &&
+      SealedMemToShadow(SealedMemToShadow(top)) ==
+          SealedMemToShadow(SealedMemToShadow(top) + 1) - 1;
+}
+static_assert(SealedLayoutHolds(kSealedSv48TopOfMemory),
+              "the sealed shadow offset does not lay out an Sv48 space");
+static_assert(SealedLayoutHolds(kSealedSv39TopOfMemory),
+              "the sealed shadow offset does not lay out an Sv39 space");
+
+// The largest address space this runtime runs in.  It is what sizes the first
+// level of the bytemap the internal allocator uses to find a region's size
+// class, through SANITIZER_MMAP_RANGE_SIZE in sanitizer_platform.h, and a
+// smaller detected space uses a prefix of that map.  They were allowed to
+// disagree once -- the pin said Sv48 and the range size said 56 bits -- and
+// the cost of that was not wrongness but 128MiB of .bss where 256KiB was
+// called for.  A header that sanitizer_platform.h could include would be the
+// tidier fix; it includes nothing, by design, so this is what holds the two
+// together: move one and this stops the build until the other moves with it.
+const uptr kSealedMaxUserVirtualAddress = kSealedSv48TopOfMemory;
 static_assert(kSealedMaxUserVirtualAddress == SANITIZER_MMAP_RANGE_SIZE - 1,
-              "sealed riscv64 pins the top user address, and "
+              "sealed riscv64 names the largest address space it runs in, and "
               "SANITIZER_MMAP_RANGE_SIZE names the same address space; they "
               "have to be the same number");
 #endif
 
-// The frame the runtime's initialization started on, recorded by __asan_init
-// before it calls anything, and 0 until it does.
+// sealed_init_frame, declared above: the frame the runtime's initialization
+// started on, recorded by __asan_init before it calls anything, and 0 until
