 #  include "sanitizer_common/sanitizer_procmaps.h"
+#  include "sanitizer_common/sanitizer_sealed.h"
 
 namespace __asan {
 
@@ -41,6 +42,14 @@ void AsanOnDeadlySignal(int signo, void *siginfo, void *context) {
 }
 
 bool PlatformUnpoisonStacks() {
+  // This runs on the way out of every program that calls a noreturn function,
+  // _exit() included, so it is start-up's counterpart and is sealed for the
+  // same reason.  There is nothing to ask about: sealed init pins
+  // use_sigaltstack to false, so no alternate stack was ever installed, and
+  // returning false is how this reports "the default stack is the one we are
+  // on", which is what the caller then unpoisons.
+  if (SealedInit())
+    return false;
   stack_t signal_stack;
   CHECK_EQ(0, sigaltstack(nullptr, &signal_stack));
   uptr sigalt_bottom = (uptr)signal_stack.ss_sp;
diff --git a/compiler-rt/lib/asan/asan_rtl.cpp b/compiler-rt/lib/asan/asan_rtl.cpp
index ffbd2e8..9e06a1a 100644
--- a/compiler-rt/lib/asan/asan_rtl.cpp
+++ b/compiler-rt/lib/asan/asan_rtl.cpp
@@ -29,6 +29,7 @@
 #include "sanitizer_common/sanitizer_flags.h"
 #include "sanitizer_common/sanitizer_interface_internal.h"
 #include "sanitizer_common/sanitizer_libc.h"
+#include "sanitizer_common/sanitizer_sealed.h"
 #include "sanitizer_common/sanitizer_symbolizer.h"
 #include "ubsan/ubsan_init.h"
 #include "ubsan/ubsan_platform.h"
@@ -336,6 +337,50 @@ static void asan_atexit() {
   }
 }
 
+// Sealed init writes the top of memory into the binary rather than measuring it
+// -- the Sv48 layout on riscv64, the 3G/1G split on a 32-bit target -- and a
+// process that was given more than that cannot be sanitized by this binary at
+// all: HighMem ends below the stack, so AddrIsInMem is false for every stack
+// address and a shadow write for one lands past the end of the shadow, in
+// somebody else's memory.
+//
+// So it is checked, once, against the only address known here to be in the
+// stack.  The alternative is not a crash at this point but a much later one: an
+// ASan CHECK inside asan_poisoning.cpp that does not mention the address space,
+// or, past that, memory quietly overwritten.
+//
+// The message is written with Printf and the exit is internal__exit, rather than
+// Report and Die, and that is deliberate rather than tidiness.  Report prefixes
+// "==pid==", which is a getpid; Die runs the die callbacks, and one of them
+// dumps the process map, which is a /proc read.  A failure this mode can produce
+// should stay inside the syscalls it promises even though it is a failure --
+// the caller reasoning about these binaries is quantifying over the runs that
+// reach it, and a diagnostic that leaves the modeled set makes those runs
+// unanalysable rather than merely failed.
+static void CheckSealedAddressSpace() {
+  if (!SealedInit())
+    return;
+  uptr frame;
+  uptr sp = reinterpret_cast<uptr>(&frame);
+  if (sp <= kHighMemEnd)
+    return;
+  Printf(
+      "AddressSanitizer: sealed init puts the top of memory at %p, and this "
+      "process's stack is at %p, which is above it.\n",
+      (void *)kHighMemEnd, (void *)sp);
+#if SANITIZER_RISCV64
+  Printf(
+      "A sealed riscv64 binary carries the Sv48 layout, whose stack top is "
+      "0x800000000000.  A kernel running Sv39 puts it at 0x4000000000 instead, "
+      "and this binary cannot run there.\n");
+#else
+  Printf(
+      "A sealed binary carries the top of memory its architecture's default "
+      "mapping has, and this kernel gives a process more than that.\n");
+#endif
