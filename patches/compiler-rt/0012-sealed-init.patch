 #  include "sanitizer_common/sanitizer_libc.h"
 #  include "sanitizer_common/sanitizer_procmaps.h"
+#  include "sanitizer_common/sanitizer_sealed.h"
 
 #  if SANITIZER_FREEBSD
 #    include <sys/link_elf.h>
@@ -86,6 +87,19 @@ uptr FindPremappedShadowStart(uptr shadow_size_bytes) {
 #  endif
 
 uptr FindDynamicShadowStart() {
+#  if SANITIZER_RISCV64
+  // riscv64 is the only architecture this is reached on here, and this is the
+  // second half of pinning its mapping: the probe below asks the kernel for
+  // somewhere to put a shadow whose size came from GetMaxVirtualAddress(), so
+  // both the size and the address are facts about the run rather than about
+  // the binary.  Sealed mode names the offset instead.  It is the offset
+  // asan_mapping.h documents for a 47-bit user address space, x86_64's
+  // included, and it agrees with the kSealedMaxUserVirtualAddress that
+  // GetMaxVirtualAddress() has already returned: the shadow of everything
+  // below 0x7fffffffffff, placed at 0x7fff8000, ends at 0x10007fff7fff.
+  if (SealedInit())
+    return kSealedShadowOffset;
+#  endif
   uptr shadow_size_bytes = MemToShadowSize(kHighMemEnd);
 #  if ASAN_PREMAP_SHADOW
   if (!PremapShadowFailed())
@@ -182,6 +196,16 @@ void AsanCheckIncompatibleRT() {
       // as early as possible, otherwise ASan interceptors could bind to
       // the functions in dynamic ASan runtime instead of the functions in
       // system libraries, causing crashes later in ASan initialization.
+      //
+      // Sealed mode skips the walk, which is a /proc/self/maps read.  What it
+      // looks for is a libclang_rt.asan.so mapped alongside the static runtime,
+      // and a binary this mode is built for is statically linked with no
+      // PT_INTERP: nothing mapped one before the program started and there is
+      // no loader in it to map one later.
+      if (SealedInit()) {
+        __asan_rt_version = ASAN_RT_VERSION_STATIC;
+        return;
+      }
       MemoryMappingLayout proc_maps(/*cache_enabled*/ true);
       char filename[PATH_MAX];
       MemoryMappedSegment segment(filename, sizeof(filename));
