diff --git a/compiler-rt/lib/asan/asan_flags.cpp b/compiler-rt/lib/asan/asan_flags.cpp
index 9cfb70b..bdaa5d8 100644
--- a/compiler-rt/lib/asan/asan_flags.cpp
+++ b/compiler-rt/lib/asan/asan_flags.cpp
@@ -20,6 +20,7 @@
 #include "sanitizer_common/sanitizer_common.h"
 #include "sanitizer_common/sanitizer_flag_parser.h"
 #include "sanitizer_common/sanitizer_flags.h"
+#include "sanitizer_common/sanitizer_sealed.h"
 #include "sanitizer_common/sanitizer_win_interception.h"
 #include "ubsan/ubsan_flags.h"
 #include "ubsan/ubsan_platform.h"
@@ -212,9 +213,99 @@ static void ProcessFlags() {
   }
 }
 
+// The flags sealed init decides, whatever anything else asked for.
+//
+// Each one is a syscall this mode exists to not make, and each is applied
+// after every other source of flag values -- the compile-time default, the
+// ASAN_DEFAULT_OPTIONS definition, __asan_default_options() -- so that the
+// guarantee is a property of the link and not of what the program remembered
+// to ask for.  A sealed binary that wants a signal handler does not want a
+// sealed binary.
+//
+// Eight of them are the syscalls: the six handle_* flags are the rt_sigaction
+// calls and the rt_sigprocmask musl makes around installing each handler,
+// use_sigaltstack is the sigaltstack pair, and disable_coredump is two of the
+// three prlimit64 calls (the third is a getrlimit(RLIMIT_STACK) that goes with
+// the /proc read it accompanies).
+//
+// detect_leaks is here for a different reason, and it is the one thing in this
+// mode that removes a capability rather than a syscall.  The leak check runs at
+// exit, which is to say on every run and not only on a failing one, and it
+// cannot be sealed at all: StopTheWorld clones a tracer and ptraces the
+// process, and the scan walks /proc/self/maps for its root regions.  Leaving
+// it on would mean a mode whose start-up is sealed and whose exit is not.
+//
+// The three background-thread flags are off by default; they are pinned
+// because turning any of them on starts a thread, which is a clone, before
+// main.
+//
+// allocator_release_to_os_interval_ms is the ninth syscall, and unlike the
+// eight above it is not an init-time one -- which is why sealing start-up did
+// not remove it, and why it stayed unnoticed until a workload allocated enough
+// to trip it.  The primary allocator's MaybeReleaseToOS() reads
+// MonotonicNanoTime(), a clock_gettime(CLOCK_MONOTONIC), once a size class has
+// a page's worth of freed chunks.  A negative interval turns the heuristic off
+// and both automatic call sites are guarded by it -- see
+// sanitizer_allocator_primary64.h, `if (ReleaseToOSIntervalMs() >= 0)` before
+// the postponement stamp and `if (interval_ms < 0) return;` before the release
+// itself.  What is left is the force path behind __sanitizer_purge_allocator(),
+// which is an explicit call a program either makes or does not.
+//
+// abort_on_error is the last, and it is not a syscall a healthy run makes: it
+// is how a run that FOUND a bug dies.  Die() otherwise leaves by
+// exit_group(exitcode), and an exit status is a channel the program also has
+// -- a caller comparing this binary's syscalls against its plain twin's
+// cannot tell that exit from one the program chose.  Abort() dies by SIGABRT,
+// whose rt_sigprocmask + tkill nothing on a healthy run emits, so a
+// detection is unambiguous to every observer.  The report itself still
+// prints and the abort's own two syscalls are accepted: a run that found a
+// bug has already left the behaviour sealing is about, and what this pin
+// changes is only the last event, from an exit the program could have made
+// to a signal it could not.  Pinned here, after __asan_default_options()
+// has been parsed, a program's hook cannot reset it; that ordering is
+// load-bearing for a consumer whose hook pins allocator_may_return_null=1
+// and must not unpin this.
+static void SealFlags() {
+  if (!SealedInit())
+    return;
+  // CopyFrom overwrites all of cf, so the pattern fill that
+  // -ftrivial-auto-var-init would emit first is dead; leaving it out pays
+  // for the pins below without growing InitializeFlags (see below).
+  [[clang::uninitialized]] CommonFlags cf;
+  cf.CopyFrom(*common_flags());
+  cf.handle_segv = kHandleSignalNo;
+  cf.handle_sigbus = kHandleSignalNo;
+  cf.handle_abort = kHandleSignalNo;
+  cf.handle_sigill = kHandleSignalNo;
+  cf.handle_sigtrap = kHandleSignalNo;
+  cf.handle_sigfpe = kHandleSignalNo;
+  cf.use_sigaltstack = false;
+  cf.disable_coredump = false;
+  cf.detect_leaks = false;
+  cf.hard_rss_limit_mb = 0;
+  cf.soft_rss_limit_mb = 0;
+  cf.heap_profile = false;
+  cf.allocator_release_to_os_interval_ms = -1;
+  cf.abort_on_error = true;
+  // One frame per allocation and free: the stack depot then stores one
+  // trace per allocation site, not one per distinct call path, so it does
+  // not grow with the workload.  The depot's background compression
+  // thread (a clone) stays off.  Printing the module map reads
+  // /proc/self/maps, and decorate_proc_maps names mappings with prctl;
+  // both are syscalls a hook could otherwise turn on.  With the pattern
+  // fill above gone, these four stores leave InitializeFlags at its old
+  // size, so no other code in a linked binary moves.
+  cf.malloc_context_size = 1;
+  cf.compress_stack_depot = 0;
+  cf.print_module_map = 0;
+  cf.decorate_proc_maps = false;
+  OverrideCommonFlags(cf);
+}
+
 void InitializeFlags() {
   InitializeDefaultFlags();
   ProcessFlags();
+  SealFlags();
 
 #if SANITIZER_WINDOWS
   // On Windows, weak symbols are emulated by having the user program
