 .../sanitizer_linux_libcdep.cpp                       |  30 ++++++++++++++++++++++++++++++
 compiler-rt/lib/sanitizer_common/sanitizer_posix.cpp  |  13 +++++++++++++
 compiler-rt/lib/sanitizer_common/sanitizer_sealed.h   | 156 ++++++++++++++++++++++++++++++
