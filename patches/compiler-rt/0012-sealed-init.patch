diff --git a/compiler-rt/lib/sanitizer_common/sanitizer_sealed.h b/compiler-rt/lib/sanitizer_common/sanitizer_sealed.h
new file mode 100644
index 0000000..77858ae
--- /dev/null
+++ b/compiler-rt/lib/sanitizer_common/sanitizer_sealed.h
@@ -0,0 +1,156 @@
+//===-- sanitizer_sealed.h --------------------------------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Sealed init: a link-time mode in which everything the runtime does before
+// the program's first instruction, and everything it does on the way out, is
+// a function of the binary alone.
+//
+// It is off unless the link defines __sanitizer_sealed_init, so nothing here
+// changes what an ordinary build does.  What it changes when it is on:
+//
+//   - no environment is read, by any mechanism.  Not getenv, and not
+//     /proc/self/environ, which is where GetEnv() reads it from on Linux.
+//     ASAN_OPTIONS, LSAN_OPTIONS, UBSAN_OPTIONS and ASAN_SYMBOLIZER_PATH all
+//     go through GetEnv(), so sealing that one function is what makes this
+//     total rather than a list of names.  Options come from the compiled-in
+//     defaults and from __asan_default_options(), which is part of the binary.
+//   - no /proc is read: not environ, not cmdline, not maps, and /proc/self/exe
+//     is not resolved either.
+//   - no signal handler is installed and no alternate signal stack is set up,
+//     so no rt_sigaction, sigaltstack or rt_sigprocmask.
+//   - no madvise, so the allocator does not return pages to the OS and the
+//     shadow is neither MADV_DONTDUMP nor MADV_NOHUGEPAGE.
+//   - no prlimit64: the core dumper is left alone and RLIMIT_STACK is not read.
+//   - no getpid.
+//   - a detection dies by SIGABRT rather than by exit_group: abort_on_error
+//     is pinned to 1 (SealFlags, asan_flags.cpp), so a run that found a bug
+//     is killed by a signal the program could not have chosen as an exit
+//     status, where an exit_group(exitcode) is an event its plain twin could
+//     also have made.
+//   - on riscv64, the shadow offset and the size of the shadow reservation are
+//     constants rather than being derived from the address of the current
+//     frame, and the constants are the Sv48 layout's.  See
+//     kSealedMaxUserVirtualAddress below.
+//
+// What remains at start-up is mmap, munmap, mprotect and the program's own
+// syscalls.  A run that reports an error is not sealed and is not meant to be:
+// symbolization and the report itself do what they always did, except for the
+// last event -- abort_on_error is pinned, so the death under a report is a
+// SIGABRT rather than an exit status the program could also have produced.
+// The property this mode is for is a property of a run that does not
+// report anything, which is every run of a correct program.
+//
+// Why anyone wants this.  A caller who reasons about a binary formally has to
+// quantify over the things the process starts with -- the environment, the
+// filesystem, the initial stack pointer -- and a runtime that reads any of
+// them makes its own behaviour a function of a universally quantified
+// variable.  ASAN_OPTIONS=verbosity=1 is a legal environment, and under it an
+// instrumented binary writes to stderr where the uninstrumented one is silent;
+// that is a difference in observable behaviour that has nothing to do with
+// memory safety.  /proc/self/maps is a file, and an initial filesystem in
+// which it holds something else is a legal filesystem.  Sealing is what makes
+// those quantifiers survivable, and it is why the seal has to be complete
+// rather than merely quiet: a single GetEnv() left standing is a run whose
+// output the environment decides.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef SANITIZER_SEALED_H
+#define SANITIZER_SEALED_H
+
+#include "sanitizer_internal_defs.h"
+#include "sanitizer_platform.h"
+
+extern "C" {
+// Defined by the link, as an absolute symbol, when sealed init is wanted:
+//
+//   -Wl,--defsym=__sanitizer_sealed_init=1
+//
+// and left as an undefined weak symbol, whose address is 0, when it is not.
+// The switch is a symbol rather than a build option so that one runtime
+// archive serves both modes: a second build of compiler-rt would have to be
+// installed, selected and kept in step with the first, and the two would
+// differ in a way no test could compare within a single image.  It is a link
+// flag rather than a run-time flag because a run-time flag would have to be
+// read from somewhere, and the environment is exactly what this mode is for
+// not reading.
+SANITIZER_WEAK_ATTRIBUTE extern char __sanitizer_sealed_init;
+}
+
+namespace __sanitizer {
+
+// Sealed init is decided by the link and never changes afterwards, so this is
+// a constant to every caller and the branches below fold away in each run.
+inline bool SealedInit() { return &__sanitizer_sealed_init != nullptr; }
+
+#if SANITIZER_RISCV64
+// riscv64 is the one architecture here whose shadow offset is not a constant:
+// asan_mapping.h selects ASAN_SHADOW_OFFSET_DYNAMIC for it, the offset comes
+// out of an mmap probe sized by GetMaxVirtualAddress(), and that function
+// answers `(1 << (msb(current frame) + 1)) - 1` because RISC-V has three
+// address space layouts (Sv39, Sv48, Sv57) and nothing tells a process which
+// one it is running under.  So the size of the shadow reservation is a
+// function of the initial stack pointer.
+//
+// Sealed mode pins both to the Sv48 layout, which is the one Linux/riscv64
+// gives a process on any kernel with VA_BITS >= 48: STACK_TOP is
+// DEFAULT_MAP_WINDOW = 1 << (MMAP_VA_BITS - 1), and MMAP_VA_BITS saturates at
+// 48, so the stack top is 0x800000000000 under Sv48 and Sv57 alike and the top
+// user address is 0x7fffffffffff.  The offset is the one asan_mapping.h already
+// uses for every other 47-bit user address space, x86_64's included:
+//
+//   || `[0x10007fff8000, 0x7fffffffffff]` || HighMem    ||
+//   || `[0x02008fff7000, 0x10007fff7fff]` || HighShadow ||
+//   || `[0x00008fff7000, 0x02008fff6fff]` || ShadowGap  ||
+//   || `[0x00007fff8000, 0x00008fff6fff]` || LowShadow  ||
+//   || `[0x000000000000, 0x00007fff7fff]` || LowMem     ||
+//
+// Sv39 is the other plausible pin, and it is the wrong one here even though it
+// is what much riscv64 hardware runs and it would make the reservation 4GB
+// rather than 14TB.  A caller reasoning about these binaries quantifies the
+// initial stack pointer over the window a kernel can put it in, and on an Sv48
+// kernel every such stack address is above an Sv39 ceiling -- so an Sv39-sealed
+// binary would take the diagnostic path below on every admissible run, which is
+// worse than not sealing at all.  Changing this pin is these two constants and
+// the mapping table above; nothing else here depends on which it is.
+const uptr kSealedMaxUserVirtualAddress = 0x7fffffffffffULL;
+const uptr kSealedShadowOffset = 0x7fff8000ULL;
+#endif
+
+// The frame the runtime's initialization started on, recorded by __asan_init
+// before it calls anything, and 0 until it does.
+//
+// It has to be that frame and not the one that reads it.  What reads it is
+// GetThreadStackTopAndBottom, and what the bound it computes has to contain is a
+// local of SetThreadStackAndTls, which is one of its callers and therefore at a
+// higher address -- AsanThread checks it there, with CHECK(AddrIsInStack(&local)).
+// Rounding the reading frame up to a page usually covers the callers in between
+// and does not when that frame lands within a few hundred bytes below a page
+// boundary, which is a fact about the size of the environment, since that is
+// what moves the initial stack pointer.  A bound taken on the way in, above
+// every frame that will be checked against it, cannot have that argument made
+// about it.
+extern uptr sealed_init_frame;
+void SealedSetInitFrame(uptr frame);
+
+// The window sealed mode calls the main thread's stack, ending at the frame
+// __asan_init runs on.  Finding the real bounds means reading /proc/self/maps
+// for the [stack] segment and getrlimit(RLIMIT_STACK) for how far down it may
+// grow, which is a /proc read and a prlimit64; a fixed window needs neither.
+//
+// 8MB is Linux's default RLIMIT_STACK, so the window covers a stack that grows
+// to that limit, and the few KB above __asan_init's frame that it does not
+// cover are the argv and environ strings the kernel wrote there, which no
+// frame is ever placed in.  Nothing reads or writes this range on account of
+// these bounds; they decide how a stack address is described in a report and
+// how much shadow __asan_handle_no_return clears.
+const uptr kSealedMainStackSize = 8ULL << 20;
+
+}  // namespace __sanitizer
+
+#endif  // SANITIZER_SEALED_H
