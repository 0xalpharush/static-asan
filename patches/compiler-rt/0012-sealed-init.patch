 compiler-rt/lib/asan/asan_linux.cpp                   |  24 ++++++++++++++++++++++++
 compiler-rt/lib/asan/asan_posix.cpp                   |   9 +++++++++
 compiler-rt/lib/asan/asan_rtl.cpp                     |  80 +++++++++++++++++++++++++++---
 compiler-rt/lib/asan/asan_thread.cpp                  |   6 +++++-
 compiler-rt/lib/sanitizer_common/sanitizer_common.cpp |  18 ++++++++++++++++++
