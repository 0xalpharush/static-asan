From 473a1032d584ed79c116283c140f2cc9e7ddb10b Mon Sep 17 00:00:00 2001
From: 0xalpharush <0xalpharush@protonmail.com>
Date: Mon, 26 Oct 2026 12:10:00 +0000
Subject: [PATCH] [compiler-rt] msan: a sealed start-up
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

🤖: Sealed init (patch 0012) made the common runtime read no environment and no
/proc, but MSan's own start-up still took paths that break the sealed contract.
The maintainers ran sealed MSan 20x with ASLR on and saw 7/20 die by SIGSEGV
with no report, and a detection exit 1 after printing MemorySanitizer:DEADLYSIGNAL
-- a signal handler installed and a death the contract forbids.  This gives MSan
the sealed start-up ASan already has, mechanism for mechanism, in MSan's own
code: sharing asan's would rebuild the asan runtime and move the archive md5 the
OSS-Fuzz proofs record.

Shadow reservation (msan_linux.cpp).  Unsealed MSan dry-runs the layout with
MemoryRangeIsAvailable, re-execs if it conflicts, then MAP_FIXEDs its shadow.
In sealed mode MemoryRangeIsAvailable answers yes unasked (0012), so the dry run
cannot fail and the MAP_FIXED covers whatever the program or kernel had already
placed in a shadow range -- a placement the specification these binaries are
verified against admits.  SealedReserveShadow instead reserves every SHADOW and
mapped-ORIGIN range readable-writable and every INVALID and unmapped-ORIGIN
range PROT_NONE, each with MAP_FIXED_NOREPLACE, and spins on refusal via the
common SealedHangOnAllocationFailure -- the shape of 0019's SealedReserveShadow
for ASan.  The allocator's space is left to the sealed common allocator
(0015/0017/0022), as it is for ASan.

SealFlags (msan.cpp).  ASan pins a set of sanitizer-neutral common flags in
asan_flags.cpp's SealFlags(); MSan had none, so its handlers stayed installed,
a detection exited rather than aborting, and start-up still spawned the clones
and read the /proc those flags keep off.  The same set is pinned at the end of
InitializeFlags, after __msan_default_options() and MSAN_OPTIONS are parsed so a
program hook cannot reset it: handle_* = kHandleSignalNo and use_sigaltstack
off (no signal handler); abort_on_error on (a detection dies by SIGABRT, not an
exit status the program could have returned); hard/soft_rss_limit_mb 0 (no RSS
limit thread, a pre-main clone); malloc_context_size 1, compress_stack_depot 0,
print_module_map 0, decorate_proc_maps false (one frame per allocation, no depot
compression clone, no /proc/self/maps read, no prctl mapping names).  The values
are duplicated from asan's seal rather than shared, on purpose.

ReExec (msan.cpp).  MSan also re-execs when the stack limit is unlimited.  In
sealed mode GetArgsAndEnv returns empty, so that ReExec would run /proc/self/exe
with an empty argv and environment; it is gated off, as the dry-run re-exec is.

Keeps the SealedSetInitFrame patch, which records the frame this start-up
describes the main stack from.

Not built here: this toolchain cross-builds and the maintainers run the binaries;
the reserve/flag/re-exec paths mirror ASan's but the sealed behaviour has not
been run from this change.
---
 compiler-rt/lib/msan/msan.cpp       | 59 ++++++++++++++++++++++-
 compiler-rt/lib/msan/msan_linux.cpp | 75 +++++++++++++++++++++++++++++
 2 files changed, 133 insertions(+), 1 deletion(-)

diff --git a/compiler-rt/lib/msan/msan.cpp b/compiler-rt/lib/msan/msan.cpp
index 51ce7ce..1aa657d 100644
--- a/compiler-rt/lib/msan/msan.cpp
+++ b/compiler-rt/lib/msan/msan.cpp
@@ -168,6 +168,57 @@ static void RegisterMsanFlags(FlagParser *parser, Flags *f) {
                           "deprecated, use halt_on_error");
 }
 
+// Sealed init must install no signal handler and must die by a signal on a
+// detection, not by an exit status the program itself could have returned.  ASan
+// pins the common flags that decide both in asan_flags.cpp's SealFlags(); this
+// is the same pinning for MSan.  Those flags are sanitizer-common, so the body
+// is asan's, minus asan's shadow-gap flag.  Pinned at the end of
+// InitializeFlags, after __msan_default_options() and MSAN_OPTIONS have been
+// parsed, so a program's own hook cannot reset it -- load-bearing for a consumer
+// whose hook pins other flags and must not unpin these.
+static void SealFlags() {
+  if (!SealedInit())
+    return;
+  // CopyFrom overwrites all of cf, so the pattern fill -ftrivial-auto-var-init
+  // would emit first is dead; leaving it out pays for the stores below.
+  [[clang::uninitialized]] CommonFlags cf;
+  cf.CopyFrom(*common_flags());
+  // No signal handler is installed and none is needed: a sealed detection dies
+  // by the abort below, which is a signal the program could not have chosen as
+  // an exit status.
+  cf.handle_segv = kHandleSignalNo;
+  cf.handle_sigbus = kHandleSignalNo;
+  cf.handle_abort = kHandleSignalNo;
+  cf.handle_sigill = kHandleSignalNo;
+  cf.handle_sigtrap = kHandleSignalNo;
+  cf.handle_sigfpe = kHandleSignalNo;
+  cf.use_sigaltstack = false;
+  cf.disable_coredump = false;
+  cf.detect_leaks = false;
+  // The RSS limit is enforced by a background thread the runtime clones before
+  // main; pinned off so a program hook cannot reintroduce that task.
+  cf.hard_rss_limit_mb = 0;
+  cf.soft_rss_limit_mb = 0;
+  cf.heap_profile = false;
+  cf.allocator_release_to_os_interval_ms = -1;
+  // One frame per allocation and free: the stack depot then holds one trace per
+  // allocation site, not one per distinct call path, so it does not grow with
+  // the workload.  Its background compression thread (a clone) stays off.
+  // Printing the module map reads /proc/self/maps, and decorate_proc_maps names
+  // mappings with prctl; both are syscalls a hook could otherwise turn on.
+  // These mirror the sanitizer-neutral pins asan's SealFlags makes; MSan sets
+  // them in its own code, since sharing asan's would rebuild the asan runtime.
+  cf.malloc_context_size = 1;
+  cf.compress_stack_depot = 0;
+  cf.print_module_map = 0;
+  cf.decorate_proc_maps = false;
+  // A detection dies by SIGABRT, not by an exit status the program could also
+  // have returned.  Pinned here, after __msan_default_options() and MSAN_OPTIONS
+  // are parsed, so a program's hook cannot reset it.
+  cf.abort_on_error = true;
+  OverrideCommonFlags(cf);
+}
+
 static void InitializeFlags() {
   SetCommonFlagsDefaults();
   {
@@ -247,6 +298,8 @@ static void InitializeFlags() {
     Die();
   }
   if (f->store_context_size < 1) f->store_context_size = 1;
+
+  SealFlags();
 }
 
 void PrintWarningWithOrigin(uptr pc, uptr bp, u32 origin) {
@@ -496,7 +549,11 @@ void __msan_init() {
   InstallAtExitHandler(); // Needs __cxa_atexit interceptor.
 
   DisableCoreDumperIfNecessary();
-  if (StackSizeIsUnlimited()) {
+  // Sealed init does not re-exec: GetArgsAndEnv returns empty vectors, so a
+  // ReExec would run /proc/self/exe with an empty argv and environment -- a
+  // start-up no ordinary run makes.  The sealed shadow is reserved without it
+  // (see InitShadowWithReExec / SealedReserveShadow).
+  if (!SealedInit() && StackSizeIsUnlimited()) {
     VPrintf(1, "Unlimited stack, doing reexec\n");
     // A reasonably large stack size. It is bigger than the usual 8Mb, because,
     // well, the program could have been run with unlimited stack for a reason.
diff --git a/compiler-rt/lib/msan/msan_linux.cpp b/compiler-rt/lib/msan/msan_linux.cpp
index 7140de7..d45a5c6 100644
--- a/compiler-rt/lib/msan/msan_linux.cpp
+++ b/compiler-rt/lib/msan/msan_linux.cpp
@@ -34,9 +34,18 @@
 #  include "msan_report.h"
 #  include "msan_thread.h"
 #  include "sanitizer_common/sanitizer_common.h"
+#  include "sanitizer_common/sanitizer_posix.h"
 #  include "sanitizer_common/sanitizer_procmaps.h"
+#  include "sanitizer_common/sanitizer_sealed.h"
 #  include "sanitizer_common/sanitizer_stackdepot.h"
 
+#  if SANITIZER_LINUX
+#    include <sys/mman.h>
+#    ifndef MAP_FIXED_NOREPLACE
+#      define MAP_FIXED_NOREPLACE 0x100000
+#    endif
+#  endif
+
 namespace __msan {
 
 void ReportMapRange(const char *descr, uptr beg, uptr size) {
@@ -172,7 +181,73 @@ static bool InitShadow(bool init_origins, bool dry_run) {
   return true;
 }
 
+#  if SANITIZER_LINUX
+// One range of the sealed shadow, mapped before the runtime's first allocation
+// with MAP_FIXED_NOREPLACE.  Mirrors asan_shadow_setup.cpp's SealedReserveRange.
+static void SealedReserveRange(uptr beg, uptr size, int prot, const char *name) {
+  if (size == 0)
+    return;
+  uptr res = internal_mmap(
+      reinterpret_cast<void *>(beg), size, prot,
+      MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+  // Anything but the range itself -- an errno (EEXIST: a mapping already there;
+  // ENOMEM: the layout does not fit), or a placement elsewhere by a kernel that
+  // predates the flag and read it as a hint -- is the runtime failing to get
+  // memory for itself at start-up.  Take the one path that has: spin, making no
+  // syscall.  See SealedHangOnAllocationFailure.
+  if (res != beg)
+    SealedHangOnAllocationFailure();
+  DecreaseTotalMmap(size);  // Not counted against mmap_limit_mb, as ever.
+  (void)name;
+}
+
+// The sealed replacement for InitShadow's map/protect loop.  The unsealed path
+// asks MemoryRangeIsAvailable -- a /proc read -- and then MAP_FIXEDs, but in
+// sealed mode that question answers yes unasked (patch 0012), so the dry run
+// cannot fail and the MAP_FIXED that follows would cover whatever the program
+// or the kernel had already placed in a shadow range.  The specification these
+// binaries are verified against admits every such placement, so the runtime
+// reserves instead, with MAP_FIXED_NOREPLACE, which the kernel refuses where
+// MAP_FIXED would have replaced, and spins on refusal.  Shadow and
+// mapped-origin ranges are reserved readable-writable, invalid and
+// unmapped-origin ranges PROT_NONE -- the disposition InitShadow gives each,
+// with one more mmap flag.  The allocator's own space is left to the sealed
+// common allocator, as it is for asan.  No madvise: the sealed shadow is
+// neither MADV_DONTDUMP nor hinted (sanitizer_sealed.h).
+static void SealedReserveShadow(bool init_origins) {
+  CheckMemoryLayoutSanity();
+  const uptr maxVirtualAddress = GetMaxUserVirtualAddress();
+  for (unsigned i = 0; i < kMemoryLayoutSize; ++i) {
+    uptr start = kMemoryLayout[i].start;
+    uptr end = kMemoryLayout[i].end;
+    uptr size = end - start;
+    MappingDesc::Type type = kMemoryLayout[i].type;
+    if (start >= maxVirtualAddress)
+      continue;
+    bool map = type == MappingDesc::SHADOW ||
+               (init_origins && type == MappingDesc::ORIGIN);
+    bool protect = type == MappingDesc::INVALID ||
+                   (!init_origins && type == MappingDesc::ORIGIN);
+    if (map)
+      SealedReserveRange(start, size, PROT_READ | PROT_WRITE,
+                         kMemoryLayout[i].name);
+    else if (protect)
+      SealedReserveRange(start, size, PROT_NONE, kMemoryLayout[i].name);
+  }
+}
+#  endif  // SANITIZER_LINUX
+
 bool InitShadowWithReExec(bool init_origins) {
+#  if SANITIZER_LINUX
+  // A sealed run reserves the shadow with MAP_FIXED_NOREPLACE and never
+  // re-execs: its MemoryRangeIsAvailable answers yes unasked, so the dry run
+  // below could neither fail nor justify a re-exec, and the re-exec would run
+  // /proc/self/exe with the empty argv and environment sealed mode returns.
+  if (SealedInit()) {
+    SealedReserveShadow(init_origins);
+    return true;
+  }
+#  endif
   // Start with dry run: check layout is ok, but don't print warnings because
   // warning messages will cause tests to fail (even if we successfully re-exec
   // after the warning).
