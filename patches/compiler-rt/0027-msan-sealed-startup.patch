+// The sealed replacement for InitShadowWithReExec, called once, from the top of
+// __msan_init, before the runtime's first allocation; __msan_init does not call
+// InitShadowWithReExec at all in a sealed run.  The unsealed
+// path asks MemoryRangeIsAvailable -- a /proc read -- and then MAP_FIXEDs, but
+// in sealed mode that question answers yes unasked (patch 0012), so the dry run
+// cannot fail and the MAP_FIXED that follows would cover whatever the program
+// or the kernel had already placed in a shadow range.  The specification these
+// binaries are verified against admits every such placement, so the runtime
+// reserves instead, with MAP_FIXED_NOREPLACE, which the kernel refuses where
+// MAP_FIXED would have replaced, and spins on refusal.  Shadow and
+// mapped-origin ranges are reserved readable-writable, invalid and
+// unmapped-origin ranges PROT_NONE -- the disposition InitShadow gives each
+// (LayoutRangeAction), with one more mmap flag.
+//
+// The ALLOCATOR range is reserved too, PROT_NONE.  Unlike asan's, MSan's
+// primary allocator has a fixed base (kAllocatorSpace in msan_allocator.cpp,
+// duplicated in kMemoryLayout), which it maps with MAP_FIXED.  Left open, a
+// mapping the kernel placed there -- the [vdso] and [vvar] it places at exec,
+// or any unhinted mapping the runtime makes before the allocator starts --
+// would be replaced by that MAP_FIXED without a word.  Reserved, such a
+// mapping is a refusal here (the spin), and the allocator's MAP_FIXED later
+// lands on the runtime's own reservation.  So is the one piece of an APP range
+// the allocator maps with MAP_FIXED: its
+// region-info array, AdditionalSize() bytes at the end of its space, which is
+// the end of the ALLOCATOR range (MsanAllocatorRegionInfoRange).  The rest of
+// the APP ranges is left alone: the program is already in them.
+//
+// No madvise: the sealed shadow is neither MADV_DONTDUMP nor hinted
+// (sanitizer_sealed.h).
+void SealedReserveShadow(bool init_origins) {
+  CheckMemoryLayoutSanity();
+  const uptr maxVirtualAddress = GetMaxUserVirtualAddress();
+  for (unsigned i = 0; i < kMemoryLayoutSize; ++i) {
+    uptr start = kMemoryLayout[i].start;
+    uptr end = kMemoryLayout[i].end;
+    uptr size = end - start;
+    MappingDesc::Type type = kMemoryLayout[i].type;
+    if (start >= maxVirtualAddress)
+      continue;
+    switch (LayoutRangeAction(type, init_origins)) {
+      case RangeAction::kMap:
+        SealedReserveRange(start, size, PROT_READ | PROT_WRITE);
+        break;
+      case RangeAction::kProtect:
+      case RangeAction::kAllocator:
+        SealedReserveRange(start, size, PROT_NONE);
+        break;
+      case RangeAction::kApp:
+        break;
+    }
+  }
+  uptr region_info_beg, region_info_size;
+  MsanAllocatorRegionInfoRange(&region_info_beg, &region_info_size);
+  if (region_info_size && region_info_beg < maxVirtualAddress)
+    SealedReserveRange(region_info_beg, region_info_size, PROT_NONE);
+}
