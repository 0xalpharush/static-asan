 namespace __msan {
 
 void ReportMapRange(const char *descr, uptr beg, uptr size) {
@@ -112,6 +121,31 @@ static void CheckMemoryLayoutSanity() {
   }
 }
 
+// What start-up does with one range of kMemoryLayout, for every range type: a
+// SHADOW range, and an ORIGIN range when origins are tracked, is mapped
+// readable-writable (kMap); an INVALID range, and an ORIGIN range when they
+// are not, is protected (kProtect); the ALLOCATOR range is the primary
+// allocator's, mapped later by the allocator itself (kAllocator); an APP range
+// is the program's and is left alone (kApp).  One rule for InitShadow and for
+// the sealed reservation below, so that the two cannot disagree.
+enum class RangeAction { kMap, kProtect, kAllocator, kApp };
+
+static RangeAction LayoutRangeAction(MappingDesc::Type type, bool init_origins) {
+  switch (type) {
+    case MappingDesc::SHADOW:
+      return RangeAction::kMap;
+    case MappingDesc::ORIGIN:
+      return init_origins ? RangeAction::kMap : RangeAction::kProtect;
+    case MappingDesc::INVALID:
+      return RangeAction::kProtect;
+    case MappingDesc::ALLOCATOR:
+      return RangeAction::kAllocator;
+    case MappingDesc::APP:
+      return RangeAction::kApp;
+  }
+  UNREACHABLE("unknown MappingDesc type");
+}
+
 static bool InitShadow(bool init_origins, bool dry_run) {
   // Let user know mapping parameters first.
   VPrintf(1, "__msan_init %p\n", reinterpret_cast<void *>(&__msan_init));
@@ -140,38 +174,118 @@ static bool InitShadow(bool init_origins, bool dry_run) {
     if (start >= maxVirtualAddress)
       continue;
 
-    bool map = type == MappingDesc::SHADOW ||
-               (init_origins && type == MappingDesc::ORIGIN);
-    bool protect = type == MappingDesc::INVALID ||
-                   (!init_origins && type == MappingDesc::ORIGIN);
-    CHECK(!(map && protect));
-    if (!map && !protect) {
-      CHECK(type == MappingDesc::APP || type == MappingDesc::ALLOCATOR);
-
-      if (dry_run && type == MappingDesc::ALLOCATOR &&
-          !CheckMemoryRangeAvailability(start, size, !dry_run))
-        return false;
-    }
-    if (map) {
-      if (dry_run && !CheckMemoryRangeAvailability(start, size, !dry_run))
-        return false;
-      if (!dry_run &&
-          !MmapFixedSuperNoReserve(start, size, kMemoryLayout[i].name))
-        return false;
-      if (!dry_run && common_flags()->use_madv_dontdump)
-        DontDumpShadowMemory(start, size);
-    }
-    if (protect) {
-      if (dry_run && !CheckMemoryRangeAvailability(start, size, !dry_run))
-        return false;
-      if (!dry_run && !ProtectMemoryRange(start, size, kMemoryLayout[i].name))
-        return false;
+    switch (LayoutRangeAction(type, init_origins)) {
+      case RangeAction::kMap:
+        if (dry_run && !CheckMemoryRangeAvailability(start, size, !dry_run))
+          return false;
+        if (!dry_run &&
+            !MmapFixedSuperNoReserve(start, size, kMemoryLayout[i].name))
+          return false;
+        if (!dry_run && common_flags()->use_madv_dontdump)
+          DontDumpShadowMemory(start, size);
+        break;
+      case RangeAction::kProtect:
+        if (dry_run && !CheckMemoryRangeAvailability(start, size, !dry_run))
+          return false;
+        if (!dry_run &&
+            !ProtectMemoryRange(start, size, kMemoryLayout[i].name))
+          return false;
+        break;
+      case RangeAction::kAllocator:
+        if (dry_run && !CheckMemoryRangeAvailability(start, size, !dry_run))
+          return false;
+        break;
+      case RangeAction::kApp:
+        break;
     }
   }
 
   return true;
 }
 
+#  if SANITIZER_LINUX
+// One range of the sealed layout, mapped with MAP_FIXED_NOREPLACE.  Mirrors
+// asan_shadow_setup.cpp's SealedReserveRange.
+static void SealedReserveRange(uptr beg, uptr size, int prot) {
+  if (size == 0)
+    return;
+  uptr res = internal_mmap(
+      reinterpret_cast<void *>(beg), size, prot,
+      MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+  // Anything but the range itself -- an errno (EEXIST: a mapping already there;
+  // ENOMEM: the layout does not fit), or a placement elsewhere by a kernel that
+  // predates the flag and read it as a hint -- is the runtime failing to get
+  // memory for itself at start-up.  Take the one path that has: spin, making no
+  // syscall.  See SealedHangOnAllocationFailure.
+  if (res != beg)
