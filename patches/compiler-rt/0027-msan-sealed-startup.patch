diff --git a/compiler-rt/lib/msan/msan_allocator.cpp b/compiler-rt/lib/msan/msan_allocator.cpp
index d7d4967c9..5d6ac4c2b 100644
--- a/compiler-rt/lib/msan/msan_allocator.cpp
+++ b/compiler-rt/lib/msan/msan_allocator.cpp
@@ -154,6 +154,23 @@ static StaticSpinMutex fallback_mutex;
 
 static uptr max_malloc_size;
 
+// The primary allocator reserves kSpaceSize + AdditionalSize() at its fixed
+// base and maps its region-info array, AdditionalSize() bytes, at SpaceEnd()
+// with MAP_FIXED -- past the end of the ALLOCATOR range kMemoryLayout names, in
+// the APP range above it.  Sealed start-up reserves this range too, so a
+// mapping already there is a refusal rather than something the MAP_FIXED
+// silently replaces.
+void __msan::MsanAllocatorRegionInfoRange(uptr *beg, uptr *size) {
+#if defined(__mips64)
+  // SizeClassAllocator32: no fixed space and no region-info map.
+  *beg = 0;
+  *size = 0;
+#else
+  *beg = AP64::kSpaceBeg + AP64::kSpaceSize;
+  *size = PrimaryAllocator::AdditionalSize();
+#endif
+}
